#. Plugin Name of the plugin
#: lingua-bridge.php includes/class-admin.php:62 includes/class-admin.php:69 includes/class-translators.php:113
msgid "Lingua Bridge"
msgstr "Lingua Bridge"

#. Description of the plugin
#: lingua-bridge.php
msgid "Collega contenuti WordPress per lingua e rende visibile lo stato delle traduzioni nell'amministrazione."
msgstr "Links WordPress content by language and shows the status of translations in the admin."

#: includes/class-abilities.php:21
msgid "Leggi il contenuto da tradurre"
msgstr "Read the content to translate"

#: includes/class-abilities.php:22
msgid "Restituisce il contenuto autorizzato, la lingua di destinazione e il prompt editoriale contestuale da seguire per tradurlo."
msgstr "Returns the authorized content, the target language and the contextual editorial prompt to follow when translating it."

#: includes/class-abilities.php:64
msgid "Salva una bozza tradotta"
msgstr "Save a translated draft"

#: includes/class-abilities.php:65
msgid "Crea o aggiorna una traduzione solo se è una bozza collegata alla lingua indicata. Non cambia lo stato editoriale e non pubblica contenuti."
msgstr "Creates or updates a translation only if it is a draft linked to the given language. It does not change the editorial status and does not publish content."

#: includes/class-abilities.php:95
msgid "Leggi i testi da tradurre"
msgstr "Read the texts to translate"

#: includes/class-abilities.php:96
msgid "Come get-translation-source, ma invece del markup restituisce solo i testi da tradurre, numerati: molto meno testo sulle pagine dei builder. Si salva con save-translation-segments."
msgstr "Like get-translation-source, but instead of the markup it returns only the texts to translate, numbered: much less text on builder pages. Save with save-translation-segments."

#: includes/class-abilities.php:133
msgid "Salva una bozza dai testi tradotti"
msgstr "Save a draft from the translated texts"

#: includes/class-abilities.php:134
msgid "Crea o aggiorna la bozza tradotta dai testi di get-translation-segments: la struttura la ricostruisce WordPress dall’originale. Non cambia lo stato editoriale e non pubblica contenuti."
msgstr "Creates or updates the translated draft from the texts of get-translation-segments: WordPress rebuilds the structure from the original. It does not change the editorial status and publishes nothing."

#: includes/class-abilities.php:172
msgid "Salva una bozza di correzione"
msgstr "Save a correction draft"

#: includes/class-abilities.php:173
msgid "Crea o aggiorna una copia di revisione in bozza per contenuto pubblicato. Usa source_post_id per una traduzione collegata oppure published_post_id per contenuto pubblicato senza relazione linguistica."
msgstr "Creates or updates a draft review copy of published content. Use source_post_id for a linked translation or published_post_id for published content with no language relation."

#: includes/class-abilities.php:229
msgid "Contenuto non trovato o non supportato."
msgstr "Content not found or not supported."

#: includes/class-abilities.php:235
msgid "La lingua di destinazione non è configurata in Lingua Bridge."
msgstr "The target language is not configured in Lingua Bridge."

#: includes/class-abilities.php:238
msgid "Scegli una lingua diversa da quella del contenuto di partenza."
msgstr "Choose a language other than that of the source content."

#: includes/class-abilities.php:271
msgid "Il contenuto è troppo lungo o complesso per essere diviso in testi: usa il contenuto intero (getSource)."
msgstr "The content is too long or complex to split into texts: use the whole content (getSource)."

#: includes/class-abilities.php:294 includes/class-translations.php:678 includes/class-translations.php:788
msgid "Il contenuto di partenza non è disponibile o non hai i permessi necessari."
msgstr "The source content is not available or you do not have the required permissions."

#: includes/class-abilities.php:297
msgid "L’originale è cambiato da quando i testi sono stati letti: rileggili (getSegments) e traduci di nuovo quelli cambiati."
msgstr "The original changed since the texts were read: read them again (getSegments) and translate the changed ones again."

#: includes/class-abilities.php:301
msgid "Il contenuto è troppo lungo o complesso per essere diviso in testi: usa il contenuto intero (saveDraft)."
msgstr "The content is too long or complex to split into texts: use the whole content (saveDraft)."

#: includes/class-abilities.php:305
msgid "I testi tradotti devono essere una lista di {id, text}."
msgstr "The translated texts must be a list of {id, text}."

#. translators: %s: the id of a text, as the agent sent it.
#, php-format
#: includes/class-abilities.php:312
msgid "Testo sconosciuto o non valido: %s. Ogni voce è {id, text} con un id di getSegments."
msgstr "Unknown or invalid text: %s. Each item is {id, text} with an id from getSegments."

#: includes/class-abilities.php:408
msgid "Indica il contenuto originale oppure il contenuto pubblicato da revisionare, non entrambi."
msgstr "Give either the original content or the published content to review, not both."

#: includes/class-abilities.php:415
msgid "Indica source_post_id per una traduzione collegata oppure published_post_id per una pagina pubblicata senza relazione linguistica."
msgstr "Give source_post_id for a linked translation or published_post_id for a published page with no language relation."

