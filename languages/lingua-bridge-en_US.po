msgstr "Formal (Sie, vous, usted)"

#: includes/class-admin.php:1561
msgid "Informale (tu)"
msgstr "Informal (du, tu)"

#: includes/class-admin.php:1563
msgid "Va a DeepL come formalità e nelle istruzioni del servizio compatibile OpenAI e dell’agente."
msgstr "Sent to DeepL as formality and in the instructions of the OpenAI-compatible service and of the agent."

#: includes/class-admin.php:1575 includes/class-editor.php:183
